# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=dairy_farm_manager
DB_PORT=3306

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Secret (use a long, secure string)
JWT_SECRET=your_jwt_secret_key_here_use_a_long_secure_string_min_32_characters

# API Configuration
API_URL=http://192.168.56.1:5000
CORS_ORIGIN=*

# For Render Deployment (uncomment and update)
# DB_HOST=your-mysql-host.example.com
# DB_PASSWORD=your_secure_password
# PORT=10000
# NODE_ENV=production
